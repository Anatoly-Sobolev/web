gLeft=14;" vertex="1" parent="1"><mxGeometry x="32" y="422" width="296" height="56" as="geometry"/></mxCell><mxCell id="3014" value="Категории" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="16" y="522" width="328" height="26" as="geometry"/></mxCell><UserObject label="[иконка]  Длина&#xa;11 единиц(ы)" link="data:page/id,screen-4" id="3015"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e3a8a;fontStyle=1;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="16" y="556" width="328" height="52" as="geometry"/></mxCell></UserObject><UserObject label="[иконка]  Масса&#xa;8 единиц(ы)" link="data:page/id,screen-4" id="3016"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e3a8a;fontStyle=1;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="16" y="620" width="328" height="52" as="geometry"/></mxCell></UserObject><UserObject label="[иконка]  Время&#xa;6 единиц(ы)" link="data:page/id,screen-4" id="3017"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e3a8a;fontStyle=1;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="16" y="684" width="328" height="52" as="geometry"/></mxCell></UserObject><UserObject label="[иконка]  Температура&#xa;4 единиц(ы)" link="data:page/id,screen-4" id="3018"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e3a8a;fontStyle=1;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="16" y="748" width="328" height="52" as="geometry"/></mxCell></UserObject><UserObject label="[иконка]  Площадь&#xa;6 единиц(ы)" link="data:page/id,screen-4" id="3019"><mxCell style="rounded=1;arcSize=8;whiteSpace=wr
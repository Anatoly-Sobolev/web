<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" modified="2026-10-14T11:55:16.712Z" agent="build_prototypes.js" version="24.7.17" type="device" pages="11"><diagram id="map" name="0. Карта сайта и переходы"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Карта сайта «Мера» и пользовательские переходы" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="36" as="geometry"/></mxCell><mxCell id="3" value="Три страницы, каждая в вариантах Mobile / Tablet / Desktop. Прямоугольники — страницы (щелчок открывает прототип), стрелки — действия пользователя." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1000" height="40" as="geometry"/></mxCell><UserObject label="&lt;b&gt;Главная (index)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Конвертер величин, карточки 6 категорий, блок «О проекте»&lt;/font&gt;" link="data:page/id,screen-3" id="map-home"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#172554;strokeWidth=2;fontSize=16;fontColor=#0f172a;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="280" height="120" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;Каталог (catalog)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Поиск по названию и обозначению, фильтр по категории, таблица/список единиц&lt;/font&gt;" link="data:page/id,screen-6" id="map-catalog"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#172554;strokeWidth=2;fontSize=16;fontColor=#0f172a;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="560" y="160" width="280" height="120" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;Карточка единицы (unit?id=…)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Описание, характеристики, формулы и коэффициенты пересчёта&lt;/font&gt;" link="data:page/id,screen-9" id="map-unit"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#172554;strokeWidth=2;fontSize=16;fontColor=#0f172a;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="1060" y="160" width="280" height="120" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;Состояния интерфейса&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Результат и ошибка конвертации, пустой поиск, единица не найдена, БД недоступна, мобильное меню&lt;/font&gt;" link="data:page/id,states" id="map-states"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#eab308;strokeWidth=2;fontSize=16;fontColor=#0f172a;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="560" y="420" width="280" height="110" as="geometry"/></mxCell></UserObject><mxCell id="4" value="Меню «Каталог» / карточка категории" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="map-home" target="map-catalog"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5" value="Логотип / меню «Главная»" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="map-catalog" target="map-home"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="6" value="Щелчок по названию единицы" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="map-catalog" target="map-unit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="7" value="«← Назад к каталогу» / бейдж категории" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="map-unit" target="map-catalog"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="8" value="«Открыть в конвертере»" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="map-unit" target="map-home"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="9" value="Конвертировать" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;dashed=1;strokeColor=#ca8a04;" edge="1" parent="1" source="map-home" target="map-states"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="10" value="Поиск без результатов" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;strokeColor=#ca8a04;" edge="1" parent="1" source="map-catalog" target="map-states"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="11" value="Неверный id" style="edgeSt